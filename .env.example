# ==============================================================================
# CONFIGURACION DE SEGURIDAD (OBLIGATORIA)
# ==============================================================================
# Llave maestra de 64 caracteres hexadecimales (32 bytes) para cifrado AES-256-GCM.
# Genera una ejecutando: npm run keygen
# IMPORTANTE: Si pierdes esta llave, no podras descifrar las claves guardadas.
ENCRYPTION_KEY=

# ==============================================================================
# CONFIGURACION DEL NAVEGADOR (CHROME / PLAYWRIGHT)
# ==============================================================================
# true  = ejecuta Chrome oculto en segundo plano (recomendado para uso normal)
# false = muestra la ventana de Chrome (solo util para depuracion visual)
HEADLESS=true

# Canal de navegador: "chrome" usa tu Google Chrome instalado.
# Si prefieres Chromium de Playwright, dejalo vacio y ejecuta: npx playwright install chromium
BROWSER_CHANNEL=chrome

# Tiempo maximo de espera por operacion en milisegundos (SUNAT puede ser lento)
NAVIGATION_TIMEOUT_MS=45000

# Guarda capturas de pantalla y HTML en ./logs cuando ocurran errores o para depurar
SAVE_DEBUG_ARTIFACTS=true

# ==============================================================================
# MONITOREO Y BASE DE DATOS
# ==============================================================================
# Ruta a la base de datos SQLite local
DB_PATH=./data/sunat.db

# Cada cuantos minutos revisar en modo continuo (npm run monitor)
CHECK_INTERVAL_MINUTES=60

# Pausa entre clientes (en milisegundos) para evitar saturar SUNAT o bloqueos de IP
DELAY_BETWEEN_CLIENTS_MS=5000

# ==============================================================================
# PANEL WEB (DASHBOARD)
# ==============================================================================
# Puerto del servidor web (http://127.0.0.1:3000)
PORT=3000
HOST=127.0.0.1

